<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BootVideoManager</AssemblyName>
    <RootNamespace>BootVideoManager.App</RootNamespace>
    <Product>Boot Video Manager</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Video frames are copied straight from libvlc's buffer into the bitmap. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- XAML-instantiated types must stay public. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- Only ship the VLC binaries matching the target (x64 by default, arm64 when publishing for it). -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' != 'win-arm64'">false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">false</VlcWindowsX64Enabled>
    <!-- Previews only need network access, demuxing, decoding and raw video output: VLC's streaming,
         scripting, GUI and visualisation modules are left out. -->
    <VlcExcludedModules>plugins\stream_out\%2A;plugins\access_output\%2A;plugins\mux\%2A;plugins\lua\%2A;lua\%2A%2A;plugins\gui\%2A;plugins\visualization\%2A;plugins\video_splitter\%2A;plugins\control\%2A;plugins\services_discovery\%2A;hrtfs\%2A%2A</VlcExcludedModules>
  </PropertyGroup>

  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="$(VlcExcludedModules)" />
    <VlcWindowsArm64ExcludeFiles Include="$(VlcExcludedModules)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Windows ships as one BootVideoManager.exe: runtime, managed DLLs, native libraries and the VLC plugins are
       all bundled; native files and VLC plugins are extracted to a cache folder on first launch. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(RuntimeIdentifier.StartsWith('win'))">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

  <!-- Native packages (SkiaSharp, HarfBuzz) ship large .pdb files that end users never need. -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <!-- Linux uses the system libvlc (or the one bundled by the Flatpak runtime). -->
    <PackageReference Include="VideoLAN.LibVLC.Windows"
                      Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BootVideoManager.Core\BootVideoManager.Core.csproj" />
  </ItemGroup>

</Project>
