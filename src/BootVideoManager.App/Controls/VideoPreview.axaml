<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BootVideoManager.App.Controls.VideoPreview">
    <Grid RowDefinitions="*,Auto">
        <Border CornerRadius="6" ClipToBounds="True" Background="Black">
            <Panel>
                <Image x:Name="FrameImage" Stretch="Uniform" />
                <TextBlock x:Name="StatusText" Classes="muted" Text="Chargement de l'aperçu…"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
        </Border>
        <StackPanel x:Name="Controls" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0"
                    HorizontalAlignment="Right" IsVisible="False">
            <Button x:Name="PauseButton" Content="Pause" Click="OnPauseClicked" />
            <Button x:Name="MuteButton" Content="Couper le son" Click="OnMuteClicked" />
        </StackPanel>
    </Grid>
</UserControl>
