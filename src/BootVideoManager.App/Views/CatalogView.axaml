<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootVideoManager.App.ViewModels"
             xmlns:controls="using:BootVideoManager.App.Controls"
             xmlns:l="using:BootVideoManager.App.Localization"
             x:Class="BootVideoManager.App.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">

    <UserControl.Styles>
        <Style Selector="WrapPanel.filters > :is(Control)">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:PostDetailViewModel">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Classes="section" Text="{x:Static l:Strings.PreviewTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Static l:Strings.Close}" Command="{Binding CloseCommand}" />
                </Grid>
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="0,0,8,0">
                        <controls:VideoPreview Source="{Binding PreviewUri}" Height="250"
                                                Volume="{Binding Sound.Volume}" IsMuted="{Binding Sound.IsMuted}" />
                        <TextBlock Classes="h2" Text="{Binding Card.Title}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Classes="muted" Text="{Binding Card.AuthorText}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="muted small" Text="{Binding Card.StatsText}" VerticalAlignment="Center" />
                            <Button Classes="like" Classes.liked="{Binding Card.IsLiked}" Content="{Binding Card.LikeGlyph}"
                                    Command="{Binding Card.ToggleLikeCommand}" IsVisible="{Binding Card.CanLike}"
                                    IsEnabled="{Binding !Card.IsLikePending}"
                                    ToolTip.Tip="{Binding Card.LikeToolTip}" AutomationProperties.Name="{Binding Card.LikeToolTip}" />
                        </StackPanel>
                        <TextBlock Classes="muted small" Text="{Binding Card.TagsText}" />
                        <TextBlock Classes="muted small" Text="{Binding UploadedText}" />

                        <Grid Margin="0,8,0,0">
                            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{x:Static l:Strings.Install}" Command="{Binding Card.InstallCommand}"
                                    IsVisible="{Binding Card.CanInstall}" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{x:Static l:Strings.RemoveFromSteam}" Command="{Binding Card.RemoveCommand}"
                                    IsVisible="{Binding Card.IsInstalled}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Card.IsInstalling}">
                                <ProgressBar Value="{Binding Card.Progress}" IsIndeterminate="{Binding Card.IsProgressIndeterminate}"
                                             VerticalAlignment="Center" IsVisible="{Binding !Card.IsQueued}" />
                                <TextBlock Classes="muted small" Text="{x:Static l:Strings.Queued}" VerticalAlignment="Center"
                                           IsVisible="{Binding Card.IsQueued}" />
                                <Button Grid.Column="1" Content="{x:Static l:Strings.Cancel}" Margin="8,0,0,0" Command="{Binding Card.CancelInstallCommand}" />
                            </Grid>
                        </Grid>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{x:Static l:Strings.ViewOnSite}" Command="{Binding OpenPageCommand}" />

                        <TextBlock Classes="section" Text="{x:Static l:Strings.DescriptionTitle}" Margin="0,10,0,0" />
                        <Border Classes="accent-rule" />
                        <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
        <Border Classes="toolbar" Margin="0,0,0,10">
            <WrapPanel Classes="filters">
                <TextBox Width="250" PlaceholderText="{x:Static l:Strings.SearchPlaceholder}" Text="{Binding SearchText}"
                         AutomationProperties.Name="{x:Static l:Strings.Search}" />
                <ComboBox Width="170" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          AutomationProperties.Name="{x:Static l:Strings.Sort}" />
                <ComboBox Width="185" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                          AutomationProperties.Name="{x:Static l:Strings.VideoType}" />
                <ComboBox Width="160" ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}"
                          AutomationProperties.Name="{x:Static l:Strings.Device}" />
                <ComboBox Width="180" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}"
                          AutomationProperties.Name="{x:Static l:Strings.Duration}" />
                <ToggleButton Content="{Binding LikedFilterText}" IsChecked="{Binding ShowLikedOnly}"
                              IsVisible="{Binding IsSignedIn}" ToolTip.Tip="{x:Static l:Strings.LikedOnly}"
                              AutomationProperties.Name="{x:Static l:Strings.LikedOnly}" />
                <Button Content="{x:Static l:Strings.ResetFilters}" Command="{Binding ResetFiltersCommand}" />
                <Button Content="{x:Static l:Strings.Refresh}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Classes="h2" Text="{Binding ResultText}" />
                <TextBlock Classes="muted small" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Static l:Strings.Retry}" Margin="12,0,0,0" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>
            <Border Classes="banner-warning" IsVisible="{Binding WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <ScrollViewer x:Name="ResultsScroller" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PostCardViewModel">
                                <Border Classes="card tile" Width="232" Margin="0,4,12,12">
                                    <StackPanel>
                                        <Button Classes="thumbnail" Command="{Binding OpenDetailCommand}"
                                                ToolTip.Tip="{x:Static l:Strings.PreviewAndDetails}"
                                                AutomationProperties.Name="{Binding PreviewAutomationName}">
                                            <Panel Height="148">
                                                <Border Background="{StaticResource SurfaceRaisedBrush}" />
                                                <Image Classes="thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                                    <TextBlock Text="{Binding DurationText}" />
                                                </Border>
                                                <Border Classes="badge installed" IsVisible="{Binding IsInstalled}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                    <TextBlock Text="{x:Static l:Strings.InstalledBadge}" />
                                                </Border>
                                            </Panel>
                                        </Button>
                                        <StackPanel Margin="10,8,10,10" Spacing="2">
                                            <TextBlock Classes="card-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Classes="muted small" Text="{Binding AuthorText}" TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnDefinitions="*,Auto" Height="22">
                                                <TextBlock Classes="muted small" Text="{Binding StatsText}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="like" Classes.liked="{Binding IsLiked}" Content="{Binding LikeGlyph}"
                                                        Command="{Binding ToggleLikeCommand}" IsVisible="{Binding CanLike}"
                                                        IsEnabled="{Binding !IsLikePending}"
                                                        ToolTip.Tip="{Binding LikeToolTip}" AutomationProperties.Name="{Binding LikeToolTip}" />
                                            </Grid>
                                            <TextBlock Classes="muted small" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,8,0,0" Height="32">
                                                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        Content="{x:Static l:Strings.Install}" Command="{Binding InstallCommand}"
                                                        IsVisible="{Binding CanInstall}" />
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        Content="{x:Static l:Strings.Remove}" Command="{Binding RemoveCommand}"
                                                        IsVisible="{Binding IsInstalled}" />
                                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsInstalling}">
                                                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                 VerticalAlignment="Center" MinWidth="0" IsVisible="{Binding !IsQueued}" />
                                                    <TextBlock Classes="muted small" Text="{x:Static l:Strings.Queued}" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsQueued}" />
                                                    <Button Grid.Column="1" Content="{x:Static l:Strings.Cancel}" Margin="8,0,0,0"
                                                            Command="{Binding CancelInstallCommand}" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{x:Static l:Strings.ShowMore}" HorizontalAlignment="Center" Margin="0,4,0,24"
                            IsVisible="{Binding CanLoadMore}" Command="{Binding LoadMoreCommand}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Classes="detail" Width="440" Margin="14,0,0,14"
                    IsVisible="{Binding SelectedPost, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding SelectedPost}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
