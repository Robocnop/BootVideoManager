<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootVideoManager.App.ViewModels"
             x:Class="BootVideoManager.App.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Classes="h3" Text="{Binding Summary}" />
                <SelectableTextBlock Classes="muted small" Text="{Binding MoviesDirectory}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Actualiser" Command="{Binding RefreshCommand}" />
                <Button Content="Importer un fichier .webm…" Command="{Binding ImportCommand}" IsEnabled="{Binding HasSteam}" />
                <Button Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding HasSteam}" />
                <Button Classes="danger" Content="Tout retirer" Command="{Binding RemoveAllCommand}"
                        IsEnabled="{Binding !IsEmpty}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12">
            <Border Classes="banner-warning">
                <TextBlock TextWrapping="Wrap"
                           Text="L'interrupteur détermine si Steam peut lire chaque vidéo, sans rien retélécharger ni supprimer : une vidéo désactivée est simplement rangée dans un dossier « _disabled » voisin, et une vidéo d'origine de Steam activée est copiée dans le dossier des vidéos. Sélectionnez ensuite la vidéo dans Steam › Paramètres › Personnalisation, ou activez « Lecture aléatoire » pour que Steam choisisse au hasard parmi les vidéos activées (sous Windows, uniquement au lancement de Big Picture). Les fichiers ajoutés en dehors de l'application ne sont jamais supprimés sans confirmation." />
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Classes="h2" HorizontalAlignment="Center" Text="Aucune vidéo installée" />
                <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                           Text="Parcourez le catalogue pour installer une vidéo de démarrage ou importez votre propre fichier .webm." />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:InstalledItemViewModel">
                            <Border Classes="card" Margin="0,0,8,8" Padding="10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <Border Width="128" Height="80" CornerRadius="6" ClipToBounds="True"
                                            Background="{StaticResource SurfaceRaisedBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="card-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted small" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TypeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SizeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding FileName}" />
                                        </TextBlock>
                                        <Border Classes="pill" Classes.success="{Binding IsTracked}" Classes.warning="{Binding !IsTracked}">
                                            <TextBlock Classes="small" Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  OnContent="Activée" OffContent="Désactivée"
                                                  ToolTip.Tip="Autoriser Steam à lire cette vidéo (la désactiver ne la supprime pas)"
                                                  IsVisible="{Binding CanToggle}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleEnabledCommand}" />
                                    <Button Grid.Column="3" Content="Voir la page" Margin="0,0,8,0" VerticalAlignment="Center"
                                            IsVisible="{Binding HasPage}" Command="{Binding OpenPageCommand}" />
                                    <Button Grid.Column="4" Content="Supprimer" VerticalAlignment="Center"
                                            IsVisible="{Binding CanDelete}" Command="{Binding RemoveCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
