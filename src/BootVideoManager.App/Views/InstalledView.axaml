<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootVideoManager.App.ViewModels"
             xmlns:l="using:BootVideoManager.App.Localization"
             x:Class="BootVideoManager.App.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Classes="h2" Text="{Binding Summary}" />
                <SelectableTextBlock Classes="muted small" Text="{Binding MoviesDirectory}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Static l:Strings.Refresh}" Command="{Binding RefreshCommand}" />
                <Button Content="{x:Static l:Strings.ImportWebm}" Command="{Binding ImportCommand}" IsEnabled="{Binding HasSteam}" />
                <Button Content="{x:Static l:Strings.Share}" ToolTip.Tip="{x:Static l:Strings.ShareTip}" IsEnabled="{Binding HasSteam}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{x:Static l:Strings.ExportPack}" Command="{Binding ExportPackCommand}" />
                            <MenuItem Header="{x:Static l:Strings.ImportPack}" Command="{Binding ImportPackCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="{x:Static l:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding HasSteam}" />
                <Button Classes="danger" Content="{x:Static l:Strings.RemoveAll}" Command="{Binding RemoveAllCommand}"
                        IsEnabled="{Binding !IsEmpty}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10">
            <Border Classes="banner-update" IsVisible="{Binding StartupMovie.IsShuffleOff}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l:Strings.ShuffleOffTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Classes="muted small" Text="{x:Static l:Strings.ShuffleOffHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Margin="16,0,0,0" VerticalAlignment="Center"
                            Content="{x:Static l:Strings.ShuffleOffFix}" Command="{Binding StartupMovie.EnableCommand}" />
                </Grid>
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="muted small" Text="{Binding BusyText}" IsVisible="{Binding HasBusyText}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{x:Static l:Strings.NoVideoTitle}" />
                <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                           Text="{x:Static l:Strings.NoVideoHint}" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:InstalledItemViewModel">
                            <Border Classes="card" Margin="0,0,8,6" Padding="8">
                                <Grid ColumnDefinitions="Auto,*,Auto,112,Auto">
                                    <Border Width="142" Height="80" CornerRadius="3" ClipToBounds="True"
                                            Background="{StaticResource SurfaceRaisedBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="card-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted small" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TypeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SizeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding FileName}" />
                                        </TextBlock>
                                        <Border Classes="pill" Classes.success="{Binding IsTracked}" Classes.warning="{Binding !IsTracked}">
                                            <TextBlock Classes="small" Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  OnContent="{x:Static l:Strings.Enabled}" OffContent="{x:Static l:Strings.Disabled}"
                                                  ToolTip.Tip="{x:Static l:Strings.ToggleTip}"
                                                  IsVisible="{Binding CanToggle}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleEnabledCommand}" />
                                    <Button Grid.Column="3" Content="{x:Static l:Strings.ViewPage}" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsVisible="{Binding HasPage}" Command="{Binding OpenPageCommand}" />
                                    <Button Grid.Column="4" Content="{x:Static l:Strings.Delete}" VerticalAlignment="Center"
                                            IsVisible="{Binding CanDelete}" Command="{Binding RemoveCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
