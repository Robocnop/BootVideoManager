    </screenshot>
    <screenshot>
      <caption>Managing the installed videos</caption>
      <image>https://raw.githubusercontent.com/Robocnop/BootVideoManager/v1.3.0/docs/screenshots/installed.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/Robocnop/BootVideoManager</url>
